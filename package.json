{
  "name": "pathfinding-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --reporter=verbose"
  },
  "devDependencies": {
    "@types/delaunator": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "clipper2-ts": "^2.0.1-18",
    "delaunator": "^5.1.0",
    "earcut": "^3.2.4",
    "lil-gui": "^0.21.0",
    "robust-predicates": "^3.0.3",
    "simplex-noise": "^4.0.3"
  }
}
